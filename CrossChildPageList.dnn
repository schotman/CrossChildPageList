<?xml version="1.0" encoding="utf-8"?>
<dotnetnuke type="Package" version="5.0">
  <packages>
    <package name="CrossChildPageList" type="Module" version="05.00.01">
      <friendlyName>Child Page List</friendlyName>
      <description>A free module from DnnModule.com which displays the sub pages for a specific tab. Maintained and repackaged as a compiled module by 40Fingers (https://www.40fingers.net) for DNN 9.10 - 10.x compatibility.</description>
      <owner>
        <name>Nomen Nescio</name>
        <organization />
        <url />
        <email />
      </owner>
      <license src="License.txt"></license>
      <releaseNotes src="ReleaseNotes.txt"></releaseNotes>
      <dependencies>
        <dependency type="coreVersion">09.10.00</dependency>
      </dependencies>
      <components>
        <component type="Module">
          <desktopModule>
            <moduleName>CrossChildPageList</moduleName>
            <foldername>CrossChildPageList</foldername>
            <businessControllerClass />
            <supportedFeatures />
            <moduleDefinitions>
              <moduleDefinition>
                <friendlyName>Child Page List</friendlyName>
                <moduleControls>
                  <moduleControl>
                    <controlKey />
                    <controlSrc>DesktopModules/CrossChildPageList/View.ascx</controlSrc>
                    <supportsPartialRendering>False</supportsPartialRendering>
                    <controlTitle>Child Page List</controlTitle>
                    <controlType>View</controlType>
                    <iconFile />
                    <helpUrl>http://DnnModule.com</helpUrl>
                  </moduleControl>
                  <moduleControl>
                    <controlKey>Edit</controlKey>
                    <controlSrc>DesktopModules/CrossChildPageList/Settings.ascx</controlSrc>
                    <supportsPartialRendering>False</supportsPartialRendering>
                    <controlTitle>Child Page List Settings</controlTitle>
                    <controlType>Edit</controlType>
                    <iconFile />
                    <helpUrl>http://DnnModule.com</helpUrl>
                  </moduleControl>
                </moduleControls>
              </moduleDefinition>
            </moduleDefinitions>
          </desktopModule>
        </component>
        <component type="Assembly">
          <assemblies>
            <assembly>
              <path>bin</path>
              <name>CrossChildPageList.dll</name>
              <version>05.00.01</version>
            </assembly>
          </assemblies>
        </component>
        <component type="ResourceFile">
          <resourceFiles>
            <basePath>DesktopModules/CrossChildPageList</basePath>
            <resourceFile>
              <name>Resources.zip</name>
            </resourceFile>
          </resourceFiles>
        </component>
      </components>
    </package>
  </packages>
</dotnetnuke>
