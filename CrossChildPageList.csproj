<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>CrossChildPageList</AssemblyName>
    <RootNamespace>CrossChildPageList</RootNamespace>
    <Nullable>disable</Nullable>
    <Configurations>Debug;Release</Configurations>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>


  <!-- Framework assemblies -->
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Net.Http.WebRequest" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.ApplicationServices" />
    <Reference Include="System.Web.DynamicData" />
    <Reference Include="System.Web.Entity" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <!-- Loose content shipped in the install package (ascx markup, manifest, resx, images, docs).
       The .ascx.cs code-behind files are compiled into the DLL by the default SDK Compile glob. -->
  <ItemGroup>
    <Content Include="View.ascx" />
    <Content Include="Settings.ascx" />
    <Content Include="Template\default\List_Standard.ascx" />
    <Content Include="App_LocalResources\View.ascx.resx" />
    <Content Include="App_LocalResources\Settings.ascx.resx" />
    <Content Include="Template\default\App_LocalResources\List.ascx.resx" />
    <Content Include="images\Line.gif" />
    <Content Include="images\Node.gif" />
    <Content Include="CrossChildPageList.dnn" />
    <Content Include="License.txt" />
    <Content Include="ReleaseNotes.txt" />
    <Content Include="README.md" />
  </ItemGroup>

  <!-- The .resx are DNN localization files that must ship as loose content, NOT be embedded
       into the assembly (which is what the default SDK glob would do). The .ascx and images
       must not be auto-included as None either, since we include them as Content above. -->
  <ItemGroup>
    <EmbeddedResource Remove="**\*.resx" />
    <None Remove="**\*.ascx" />
    <None Remove="**\*.gif" />
  </ItemGroup>

  <!-- NuGet packages - ExcludeAssets="runtime" prevents copying to output, DNN provides these at runtime -->
  <ItemGroup>
    <PackageReference Include="DotNetNuke.Abstractions" Version="9.13.9" ExcludeAssets="runtime" />
    <PackageReference Include="DotNetNuke.Core" Version="9.13.9" ExcludeAssets="runtime" />
    <PackageReference Include="DotNetNuke.DependencyInjection" Version="9.13.9" ExcludeAssets="runtime" />
    <PackageReference Include="DotNetNuke.Instrumentation" Version="9.13.9" ExcludeAssets="runtime" />
    <PackageReference Include="DotNetNuke.Web" Version="9.13.9" ExcludeAssets="runtime" />
    <PackageReference Include="DotNetNuke.Web.Client" Version="9.13.9" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="5.2.9" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Core" Version="5.2.9" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="2.1.1" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Build script properties -->
  <PropertyGroup>
    <DNNFileName>CrossChildPageList</DNNFileName>
    <PackageName>CrossChildPageList</PackageName>
    <Extension>zip</Extension>
  </PropertyGroup>

  <!-- Import DNN module build scripts -->
  <Import Project="BuildScripts\ModulePackage.targets" />

  <!-- Auto-deploy to DNN site on Debug builds -->
  <Target Name="AutoDeploy" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <CallTarget Targets="ReadVariables" />
    <CallTarget Targets="DeployModule" />
  </Target>

  <!-- Deploy to site and create versioned install package on Release builds -->
  <Target Name="AutoPackage" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <CallTarget Targets="PackageAndDeploy" />
  </Target>

</Project>
